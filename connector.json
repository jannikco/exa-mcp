      "checkedAt": "2026-11-08T13:24:07.469650+00:00",
      "method": "https-get"
    }
  ],
  "verification": "mock-only",
  "providerLiveValidation": "not-run",
  "workflow": {
    "name": "Search then retrieve bounded sources",
    "description": "Find source URLs and retrieve only selected pages with bounded text size. Review per-result status and provider usage before treating an extraction as available.",
    "steps": [
      "search_web",
      "get_contents"
    ]
  },
