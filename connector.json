{
  "id": "exa",
  "name": "Exa",
  "version": "0.1.0",
  "baseUrl": "https://api.exa.ai",
  "auth": {
    "type": "header",
    "env": "EXA_API_KEY",
    "header": "x-api-key"
  },
  "description": "Search and retrieve bounded text content using a provider API key. No payment-challenge or streaming transport is implemented; read calls consume provider credits.",
  "tools": [
    {
      "name": "search_web",
      "description": "Find relevant source URLs with a bounded number of results.",
      "method": "POST",
      "path": "/search",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "numResults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "query",
          "numResults"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {},
        "body": {
          "query": "query",
          "numResults": "numResults"
        }
      },
      "sampleArguments": {
        "query": "vector database documentation",
        "numResults": 5
      },
      "provenance": [
        "https://exa.ai/docs/exa-spec.json"
      ]
    },
    {
      "name": "get_contents",
      "description": "Retrieve text for selected URLs, capped at 5000 characters per page; inspect provider per-result statuses.",
      "method": "POST",
      "path": "/contents",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "urls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://[^\\s]+$"
            },
            "minItems": 1,
            "maxItems": 10
          }
        },
        "required": [
          "urls"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {},
        "body": {
          "urls": "urls"
        }
      },
      "sampleArguments": {
        "urls": [
          "https://qdrant.tech/documentation/"
        ]
      },
      "provenance": [
        "https://exa.ai/docs/exa-spec.json"
      ],
      "body": {
        "text": {
          "maxCharacters": 5000
        }
      }
    }
  ],
  "provenance": [
    "https://exa.ai/docs/exa-spec.json"
  ],
  "sourceEvidence": [
    {
      "url": "https://exa.ai/docs/exa-spec.json",
